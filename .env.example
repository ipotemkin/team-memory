# Окружение: dev | prod (метка, на логику не влияет)
APP_ENV=dev
# Подключение к Postgres (async-драйвер asyncpg); внутри compose хост postgres
DB_URL=postgresql+asyncpg://kb:kb@postgres:5432/kb
# S3/MinIO для оригиналов файлов (адрес внутри docker-сети), учётные данные, бакет и регион
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents
S3_REGION=us-east-1
# Брокер Celery
REDIS_URL=redis://redis:6379/0
# Адаптеры портов: БД (postgres_sqlalchemy | postgres | memory), LLM и эмбеддинги (openai_compat | stub),
# хранилище (s3 | memory), очередь (celery | inline), транзакционные sink'и аудита (db | memory)
DB_BACKEND=postgres_sqlalchemy
LLM_PROVIDER=openai_compat
EMBEDDINGS_PROVIDER=openai_compat
STORAGE_BACKEND=s3
QUEUE_BACKEND=celery
AUDIT_SINKS=db
# Этап 5: OpenAI через ProxyAPI (ключ: https://proxyapi.ru -> Ключи API). НЕ коммитьте .env!
# Адрес и ключ OpenAI-совместимого API; модели чата и эмбеддингов, размерность вектора
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIM=1536
# Таймаут запроса, число ретраев (408/409/429/5xx), режим Structured Outputs, температура, размер пачки эмбеддингов
OPENAI_TIMEOUT_S=30
OPENAI_MAX_RETRIES=3
OPENAI_STRUCTURED_OUTPUTS=auto   # auto | json_schema | json_object
CHAT_TEMPERATURE=0
EMBED_BATCH_SIZE=64
# Фоновая индексация и обслуживание (Celery worker + beat)
# Ретраи индексации (задержка BACKOFF·2^попытка), сколько месяцев партиций аудита создавать вперёд
INDEX_MAX_RETRIES=3
INDEX_RETRY_BACKOFF_S=10
AUDIT_PARTITIONS_MONTHS=2
# Гибридный поиск: константа k в RRF, 1/(k + ранг) (MIN_SCORE ниже — перенастройте через `make eval`)
RRF_K=60
# Поиск (RAG)
# Сколько фрагментов брать в контекст; порог score 0..1 — ниже фрагмент отбрасывается
TOP_K=5
MIN_SCORE=0.6
# Offline / без ключа: LLM_PROVIDER=stub EMBEDDINGS_PROVIDER=stub
# Без БД: DB_BACKEND=memory STORAGE_BACKEND=memory QUEUE_BACKEND=inline
# Этап 3
# Размер пула соединений SQLAlchemy
DB_POOL_SIZE=10
S3_PUBLIC_ENDPOINT_URL=http://localhost:9100   # presigned-ссылки на скачивание, доступные с хоста/из браузера
# Этап 4 (HTTP API)
# Разрешённые источники CORS (веб-клиент), лимит загрузки в МБ
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=20
UPLOAD_FORMATS=txt,md,docx,pdf   # включённые форматы загрузки (адаптеры: txt, md, docx, pdf)
# Сколько КБ тела запроса сохранять в аудит; срок жизни ссылки на скачивание (с)
AUDIT_MAX_BODY_KB=10
DOWNLOAD_URL_TTL_S=900
# Интеграционные тесты (задаются автоматически `make test-integration` в контейнере api-test)
# TEST_DATABASE_URL=postgresql+asyncpg://kb:kb@localhost:5432/kb_test
# TEST_S3_ENDPOINT_URL=http://localhost:9100
# TEST_S3_ACCESS_KEY=minioadmin
# TEST_S3_SECRET_KEY=minioadmin
# TEST_S3_BUCKET=kb-test

# Web-панель (этап 6): адрес API для браузера
VITE_API_URL=http://localhost:8000

# --- Этап 8: эксплуатация ---
# Админ-API /admin (заголовок X-Admin-Token). Пусто -> /admin выключен (404).
ADMIN_TOKEN=
# Аудит: postgres | clickhouse | both (clickhouse: `docker compose --profile clickhouse up -d`)
AUDIT_BACKEND=postgres
CLICKHOUSE_HOST=clickhouse        # с хоста: localhost
CLICKHOUSE_PORT=8123              # HTTP внутри compose; с хоста: 8124
# Учётные данные, база/таблица ClickHouse, HTTPS
CLICKHOUSE_USER=kb
CLICKHOUSE_PASSWORD=kb
CLICKHOUSE_DATABASE=kb
CLICKHOUSE_TABLE=audit_runs
CLICKHOUSE_SECURE=false
# Раздельные OpenAI-совместимые серверы для LLM и эмбеддингов (по умолчанию OPENAI_BASE_URL/OPENAI_API_KEY)
# Ollama (профиль compose "ollama", `make ollama-pull`):
#   LLM_PROVIDER=openai_compat  EMBEDDINGS_PROVIDER=openai_compat
#   LLM_BASE_URL=http://ollama:11434/v1   EMBED_BASE_URL=http://ollama:11434/v1
#   LLM_API_KEY=ollama  EMBED_API_KEY=ollama   (Ollama ключ не проверяет, но клиент требует непустой)
#   CHAT_MODEL=qwen2.5:7b  OPENAI_STRUCTURED_OUTPUTS=json_object
#   Эмбеддинги bge-m3 (dim 1024): зарегистрировать через /admin и сделать blue/green reindex,
#   либо на чистой БД сразу EMBEDDINGS_MODEL=bge-m3 EMBEDDINGS_DIM=1024
# Пусто — используются OPENAI_BASE_URL / OPENAI_API_KEY
LLM_BASE_URL=
LLM_API_KEY=
EMBED_BASE_URL=
EMBED_API_KEY=
# Размер пачки фрагментов при blue/green-переиндексации
REINDEX_BATCH_SIZE=64
# Логи: json | text; уровень
LOG_FORMAT=json
LOG_LEVEL=INFO
# Prometheus /metrics
METRICS_ENABLED=false
